# =============================================================================
# projeto_01 — Variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env (sem o .example) e ajuste os valores conforme
# necessário. O arquivo .env é ignorado pelo Git e nunca deve ser commitado.
#
#   cp .env.example .env       (Linux/Mac)
#   Copy-Item .env.example .env    (PowerShell)
# =============================================================================

# -----------------------------------------------------------------------------
# Ano de referência para o download da PPM (Pesquisa da Pecuária Municipal).
# A PPM é anual. O ano mais recente publicado costuma ter defasagem de ~2 anos
# em relação ao ano corrente. Se deixar em branco, o pipeline pega o último
# disponível automaticamente.
# -----------------------------------------------------------------------------
PPM_ANO=2023

# -----------------------------------------------------------------------------
# Nível de log do pipeline. Valores aceitos: DEBUG, INFO, WARNING, ERROR.
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Timeout em segundos para requisições HTTP à API SIDRA. A API costuma ser
# rápida (<5s), mas em horários de pico pode demorar. Aumente se ver
# ConnectionTimeout.
# -----------------------------------------------------------------------------
HTTP_TIMEOUT=30

# -----------------------------------------------------------------------------
# Diretório onde armazenar downloads brutos. Por padrão usa data/raw dentro do
# projeto. Só ajuste se quiser apontar para um cache compartilhado externo.
# -----------------------------------------------------------------------------
# RAW_DATA_DIR=data/raw

# -----------------------------------------------------------------------------
# Semente aleatória para operações estocásticas (train/test split, permutações
# de validação). Manter fixo garante reprodutibilidade.
# -----------------------------------------------------------------------------
RANDOM_SEED=42
